# Copy to .env and fill in your values

# App
# Required outside the isolated test suite. Generate a unique random value.
SECRET_KEY=replace-with-a-unique-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# MySQL — only database used
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/treetrace

# Supabase — file storage ONLY (no Supabase DB)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET_PHOTOS=tree-photos
SUPABASE_BUCKET_QR=qr-codes

# AI providers (optional features)
PLANTNET_API_KEY=

# One-time migration utility only. Do not commit values for either variable.
MIGRATION_SOURCE_DATABASE_URL=
MIGRATION_TARGET_DATABASE_URL=

{
  "rewrites": [
    {
      "source": "/api/trees",
      "destination": "https://treetrace2backend.vercel.app/api/trees/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://treetrace2backend.vercel.app/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}